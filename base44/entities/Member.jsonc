{
  "name": "Member",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome e cognome dell'iscritto"
    },
    "email": {
      "type": "string",
      "description": "Email di contatto"
    },
    "phone": {
      "type": "string",
      "description": "Numero di telefono"
    },
    "plan": {
      "type": "string",
      "enum": [
        "Mensile",
        "Trimestrale",
        "Semestrale",
        "Annuale",
        "Day Pass"
      ],
      "description": "Tipo di abbonamento"
    },
    "plan_price": {
      "type": "number",
      "description": "Prezzo dell'abbonamento in euro"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data di inizio abbonamento"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data di scadenza abbonamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "Attivo",
        "Sospeso"
      ],
      "default": "Attivo",
      "description": "Stato amministrativo dell'abbonamento"
    },
    "notes": {
      "type": "string",
      "description": "Note interne"
    }
  },
  "required": [
    "full_name",
    "plan",
    "end_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}